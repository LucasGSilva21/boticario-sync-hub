{
  "name": "@boticario-sync-hub/backend",
  "version": "1.0.0",
  "description": "Backend de integração para sincronização de colaboradores entre ERP e SaaS (Boticário Sync Hub)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src tests --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:dispatcher": "ts-node src/workers/dispatcher/main.ts",
    "start:local": "ts-node src/workers/dispatcher/main.local.ts",
    "package": "serverless package",
    "deploy": "serverless deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-secrets-manager": "^3.1063.0",
    "@aws-sdk/client-sqs": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "bottleneck": "^2.19.5",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "serverless": "^3.40.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
